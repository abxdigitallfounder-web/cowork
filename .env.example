# Copie este arquivo para `.env.local` e preencha com os seus valores.
# `.env.local` está no .gitignore: nada daqui entra no repositório nem no ZIP.
# Na Vercel, cadastre as três variáveis em Settings > Environment Variables.

# Banco: Neon Console > seu projeto > Connect
DATABASE_URL=postgresql://usuario:senha@ep-algum-host.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Login: Neon Console > seu projeto > Auth > Configuration > Auth URL
NEON_AUTH_BASE_URL=https://ep-algum-host.neonauth.sa-east-1.aws.neon.tech/neondb/auth

# Segredo para assinar o cookie de sessão. Mínimo de 32 caracteres.
# Gere o seu com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
