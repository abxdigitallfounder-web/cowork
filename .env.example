# Copie este arquivo para `.env.local` e cole a string de conexão do seu banco Neon.
# `.env.local` está no .gitignore: a senha nunca entra no repositório nem no ZIP.
# Na Vercel, cadastre a mesma variável em Settings > Environment Variables.
DATABASE_URL=postgresql://usuario:senha@ep-algum-host.us-east-2.aws.neon.tech/neondb?sslmode=require
